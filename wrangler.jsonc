{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "slug-collective",
  "main": "dist/server/index.js",
  "compatibility_date": "2024-12-30",
  "workers_dev": true,
  "build": { "command": "npm run build" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "slug-collective",
      "migrations_dir": "drizzle"
    }
  ]
}
